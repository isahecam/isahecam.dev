{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "jsxSingleQuote": false,
  "quoteProps": "as-needed",
  "trailingComma": "all",
  "bracketSpacing": true,
  "bracketSameLine": false,
  "arrowParens": "always",
  "objectWrap": "preserve",
  "insertFinalNewline": true,
  "sortImports": {
    "groups": [
      "type-import",
      ["react-next", "value-builtin", "value-external"],
      "value-internal",
      ["value-parent", "value-sibling", "value-index"],
      "style",
      "unknown"
    ],
    "customGroups": [
      {
        "groupName": "react-next",
        "elementNamePattern": ["react", "react-dom", "react/**", "next", "next/**"]
      }
    ],
    "newlinesBetween": true,
    "ignoreCase": true
  },
  "sortTailwindcss": {
    "stylesheet": "./src/app/[locale]/globals.css",
    "functions": ["clsx", "cn", "cva", "tw", "twMerge", "twJoin"],
    "preserveDuplicates": false,
    "preserveWhitespace": false
  },
  "ignorePatterns": ["src/lib/utils.ts", "src/components/ui/**"]
}
